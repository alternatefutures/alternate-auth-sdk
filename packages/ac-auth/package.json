{
  "name": "@alternatefutures/ac-auth",
  "version": "0.2.0",
  "description": "Sign in with Alternate Clouds, framework-free: OpenID Connect discovery, PKCE, token exchange, single-flight refresh with rotation, a JWKS cache that survives issuer outages, session grace, typed claims and the device flow.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.9.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration",
    "prepublishOnly": "node ../../scripts/check-dist.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alternatefutures/alternate-auth-sdk.git",
    "directory": "packages/ac-auth"
  },
  "keywords": [
    "alternate-clouds",
    "oidc",
    "openid-connect",
    "oauth2",
    "pkce",
    "sign-in"
  ]
}
